# Backend LLM Configuration (never exposed to the browser)
# Supported providers: "groq" (e.g. openai/gpt-oss-120b) or "gemini" (e.g. gemini-4-hydrogen)
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
LLM_API_KEY="YOUR_LLM_API_KEY"

# GEMINI_API_KEY: Fallback / AI Studio Secrets key for Gemini API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional standalone backend port (default 3001 when running server/index.js)
# PORT="3001"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
